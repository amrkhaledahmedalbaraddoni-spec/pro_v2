<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     RELEASE / PRODUCTION — Network Security Policy (LAN-first sovereign app)

     P0 2026-10-28 — إصلاح «التطبيق لا يتصل بالسيرفر رغم أنهما بنفس الشبكة»:

     كان الملف يضبط base-config cleartextTrafficPermitted="false" بلا أي
     استثناء، وmanifest الإصدار كان usesCleartext="false". خادم يونس على LAN
     يعمل افتراضياً عبر HTTP على المنفذ 8088 (شهادة TLS المولّدة محلياً
     اختيارية). النتيجة: أي نسخة release تُثبَّت على الهاتف يُمنع عليها كل
     اتصال HTTP من قِبل نظام أندرويد قبل أن يصل لعميل OkHttp — برسالة
     "CLEARTEXT communication to 192.168.x.x not permitted by network security
     policy". نسخة debug وحدها كانت تعمل (لأن src/debug overlay يسمح بذلك).

     Android NSC لا يدعم CIDR داخل <domain>، لذلك لا يمكن حصر السماح بـ
     192.168/16 أو 10/8 هنا. الحل المعتمد (وهو ما تفعله تطبيقات الخوادم
     الذاتية الاستضافة):
       • السماح بـ cleartext على مستوى النظام (base-config=true).
       • فرض «محلي فقط» في الكود: ServerEndpoint.normalize() يرفض أي رابط
         http:// مضيفه ليس loopback/10/172.16-31/192.168/.local/fe80/fc00.
         كل عملاء الشبكة يمرّون عبر ServerEndpoint — لا يوجد مسار HTTP عام.
       • منع صريح (defense-in-depth) لنطاقات عامة معروفة أدناه.
       • HTTPS يبقى إلزامياً لأي مضيف عام (normalize يضيف https تلقائياً).
       • شهادات المستخدم تُوثَّق في نسخ debug فقط عبر <debug-overrides>.

     ملاحظة أمنية: إن أردت TLS كاملاً في الإنتاج، اضبط RED_TLS_PINS وشغّل
     Nginx على 8443 ثم أعد base-config إلى false — الكود يدعم الاثنين.
     ═══════════════════════════════════════════════════════════════════ -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- حظر صريح للنص الصريح تجاه نطاقات الإنترنت العامة الشائعة.
         أي مضيف غير مدرج يخضع لحارس ServerEndpoint.isLocalCleartextHost. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">google.com</domain>
        <domain includeSubdomains="true">gstatic.com</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">firebaseio.com</domain>
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <domain includeSubdomains="true">openrelayproject.io</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- User CAs trusted only when debuggable (debug builds). Release keeps system-only. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
